NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/saas_growth_engine
MONGODB_MAX_POOL_SIZE=20
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
JWT_EXPIRY=15m
JWT_REFRESH_DAYS=7
FRONTEND_URL=http://localhost:4200
CORS_ORIGINS=http://localhost:4200
RESEND_API_KEY=
EMAIL_FROM=Northstar <accounts@example.com>

# Stripe test-mode credentials. Configure the price IDs in your Stripe account.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:4200/billing/success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:4200/settings/billing
STRIPE_PORTAL_RETURN_URL=http://localhost:4200/settings/billing

# Optional frontend setting
API_BASE_URL=http://localhost:3000/api
