{
  "name": "saas-growth-engine",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @saas-growth-engine/backend --filter @saas-growth-engine/frontend dev",
    "dev:backend": "pnpm --filter @saas-growth-engine/backend start:dev",
    "dev:frontend": "pnpm --filter @saas-growth-engine/frontend start",
    "build": "pnpm --recursive --if-present build",
    "lint": "pnpm --recursive --if-present lint",
    "test": "pnpm --recursive --if-present test",
    "format": "prettier --write \"*.{json,md,yml,yaml}\" \"backend/src/**/*.ts\" \"backend/*.json\" \"frontend/src/**/*.{ts,html,scss}\" \"frontend/*.json\" \"frontend/proxy.conf.json\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"*.{json,md,yml,yaml}\" \"backend/src/**/*.ts\" \"backend/*.json\" \"frontend/src/**/*.{ts,html,scss}\" \"frontend/*.json\" \"frontend/proxy.conf.json\" \".github/workflows/*.yml\""
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
