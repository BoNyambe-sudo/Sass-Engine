{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @saas-growth-engine/frontend build",
  "outputDirectory": "frontend/dist/frontend/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://$BACKEND_HOST/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
